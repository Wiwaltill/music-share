Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Protect private data even if child .htaccess files are lost during restore.
  RewriteRule ^(?:storage|\.git|uploads/audio)(?:/|$) - [F,NC]
  RewriteRule ^s/([A-Za-z0-9_-]+)/?$ share.php?token=$1 [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
</IfModule>

<FilesMatch "^(config\.php|config\.sample\.php)$">
  Require all denied
</FilesMatch>
